/* ================================
   Material 3 Expressive – Dark
   ================================ */

* {
    font-family: "Inter", "Noto Sans", Sans-Serif;
    font-size: 13px;
}

QWidget {
    background-color: #121318;
    color: #e3e5ec;
}

/* -------- Labels -------- */
QLabel {
    padding: 6px 8px;
    background: transparent;
    font-weight: 500;
}

/* -------- Buttons -------- */
QPushButton {
    background-color: #446dff;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: 500;
}

QPushButton:hover { background-color: #5b82ff; }
QPushButton:pressed { background-color: #2f5cff; }
QPushButton:disabled {
    background-color: #2a2c34;
    color: #7b8094;
}

/* -------- Inputs -------- */
QLineEdit,
QSpinBox,
QComboBox,
QTextEdit {
    background-color: #1a1b1f;
    border: 1px solid #3a3d46;
    border-radius: 8px;
    padding: 8px;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus,
QTextEdit:focus {
    border: 2px solid #446dff;
}

/* -------- Checkboxes -------- */
QCheckBox {
    spacing: 10px;
    padding: 6px 0;
    font-weight: 500;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 2px solid #7b8094;
    background: transparent;
}

QCheckBox::indicator:checked {
    background-color: #446dff;
    border-color: #446dff;
}

QCheckBox::indicator:checked::after {
    content: "";
    width: 6px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-left: 6px;
    margin-top: 3px;
}

/* -------- Tabs -------- */
QTabWidget::pane {
    border: 1px solid #2a2c34;
    padding: 10px;
}

QTabBar::tab {
    padding: 12px 22px;
    margin-right: 8px;
    background: transparent;
    font-weight: 500;
    color: #a9acc1;
}

QTabBar::tab:selected {
    background-color: #2a2c34;
    color: #ffffff;
    font-weight: 600;
}

QTabBar::tab:hover {
    background-color: #1e2027;
}
