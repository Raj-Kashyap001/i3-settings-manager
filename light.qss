/* ================================
   Material 3 Expressive – Light
   ================================ */

* {
    font-family: "Inter", "Noto Sans", Sans-Serif;
    font-size: 13px;
}

/* -------- Base -------- */
QWidget {
    background-color: #f8f9ff;
    color: #1a1b1f;
}

/* -------- Labels -------- */
QLabel {
    padding: 6px 8px;
    background: transparent;
    font-weight: 500;
}

/* -------- Buttons -------- */
QPushButton {
    background-color: #dbe2ff;
    color: #001b3d;
    border: none;
    border-radius: 10px;
    padding: 10px 18px;
    font-weight: 500;
}

QPushButton:hover { background-color: #c3d0ff; }
QPushButton:pressed { background-color: #a8bbff; }
QPushButton:disabled {
    background-color: #e3e6ef;
    color: #9aa0b3;
}

/* -------- Inputs -------- */
QLineEdit,
QSpinBox,
QComboBox,
QTextEdit {
    background-color: #ffffff;
    border: 1px solid #c7c9d4;
    border-radius: 8px;
    padding: 8px;
}

QLineEdit:focus,
QSpinBox:focus,
QComboBox:focus,
QTextEdit:focus {
    border: 2px solid #2f5cff;
}

/* -------- Checkboxes -------- */
QCheckBox {
    spacing: 10px;
    padding: 6px 0;
    font-weight: 500;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 6px;
    border: 2px solid #6f7385;
    background: transparent;
}

QCheckBox::indicator:checked {
    background-color: #2f5cff;
    border-color: #2f5cff;
}

QCheckBox::indicator:checked::after {
    content: "";
    width: 6px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
    margin-left: 6px;
    margin-top: 3px;
}

/* -------- Tabs -------- */
QTabWidget::pane {
    border: 1px solid #d3d6e0;
    border-radius: 14px;
    padding: 10px;
}

QTabBar::tab {
    padding: 12px 22px;
    margin-right: 8px;
    border-radius: 12px;
    background: transparent;
    font-weight: 500;
    color: #444654;
}

QTabBar::tab:selected {
    background-color: #dbe2ff;
    color: #001b3d;
    font-weight: 600;
}

QTabBar::tab:hover {
    background-color: #eef1ff;
}

/* -------- Group Boxes -------- */
QGroupBox {
    border: 1px solid #d3d6e0;
    border-radius: 14px;
    margin-top: 20px;
    padding: 16px;
    background-color: #ffffff;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 14px;
    padding: 0 8px;
    font-weight: 600;
    color: #2f5cff;
}
